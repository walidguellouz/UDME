{"$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1, "newProjectRoot": "projects",
 "cli": {"analytics": false},
 "projects": {"udme": {"projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
  "architect": {"build": {"builder": "@angular/build:application",
    "options": {"outputPath": "dist/udme", "index": "src/index.html", "browser": "src/main.ts",
      "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json", "styles": ["src/styles.css"],
      "allowedCommonJsDependencies": ["cytoscape"]},
    "configurations": {"production": {"outputHashing": "all",
      "budgets": [{"type": "initial", "maximumWarning": "1MB", "maximumError": "2MB"}]},
      "development": {"optimization": false, "sourceMap": true}}, "defaultConfiguration": "production"},
   "serve": {"builder": "@angular/build:dev-server", "configurations": {
     "production": {"buildTarget": "udme:build:production"}, "development": {"buildTarget": "udme:build:development"}},
     "defaultConfiguration": "development"}}}}}
